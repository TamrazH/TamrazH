# Nümunə fayl. Real dəyərləri .env.local-a (lokal) və ya Vercel > Settings > Environment Variables-a yazın.
# Bu faylı real dəyərlərlə DOLDURMAYIN və commit etməyin.

# Google Sheets cədvəlinin ID-si (URL-də /d/ ilə /edit arasındakı hissə)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Service account məlumatı — aşağıdakı iki üsuldan BİRİNİ seçin:
# (A) Service account JSON faylının BÜTÖV məzmunu (tək sətirdə) və ya base64 kodlaşdırılmış forması
GOOGLE_SERVICE_ACCOUNT_JSON=
# (B) Ayrı-ayrı dəyərlər (private key-dəki yeni sətirlər \n kimi yazılır)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# İstəyə bağlı, lakin TÖVSİYƏ OLUNUR: sinxron endpoint-lərini qoruyan parol.
# Təyin olunarsa, Parametrlər > Google Sheets bölməsində eyni parolu daxil etmək lazımdır.
APP_SYNC_TOKEN=
